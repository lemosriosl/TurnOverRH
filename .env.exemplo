# Copie para .env e ajuste para o SEU banco.
# O .env nao vai para o git -- e por isso que a senha mora aqui e nao no codigo.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_SENHA=123
PG_DB_APP=turnover
PG_DB_MLFLOW=mlflow

# Endereco do servidor MLflow (o que voce sobe no terminal 1)
MLFLOW_URI=http://127.0.0.1:5000
